# Токен бота — ТОЛЬКО здесь, на сервере. Никогда не передавайте его во фронтенд.
BOT_TOKEN=your_bot_token_here

# Порт, на котором слушает API
PORT=8787

# Разрешённый origin фронтенда для CORS
CLIENT_ORIGIN=http://localhost:5173

# Turso — постоянная БД
TURSO_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_token_here

# Отключает строгую проверку подписи Telegram. НЕ включайте в проде.
DEV_MODE=true
