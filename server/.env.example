# Токен бота — ТОЛЬКО здесь, на сервере. Никогда не передавайте его во фронтенд.
# Получить/перевыпустить: @BotFather -> /mybots -> Bot Settings -> Revoke current token
BOT_TOKEN=your_bot_token_here

# Порт, на котором слушает API
PORT=8787

# Разрешённый origin фронтенда для CORS (адрес, где открыт Mini App / dev-сервер Vite)
CLIENT_ORIGIN=http://localhost:5173

# Отключает строгую проверку подписи Telegram initData и разрешает заголовок
# X-Dev-User для локального тестирования вне Telegram. НЕ включайте в проде.
DEV_MODE=true

# --- Постоянное хранилище (важно на Railway/любом PaaS без volume) ---
# По умолчанию (если не задано) база и фото хранятся внутри папки проекта —
# это нормально для локальной разработки, но на Railway такой диск стирается
# при каждом передеплое. В проде укажите путь внутри смонтированного Volume,
# например DATA_DIR=/data и UPLOADS_DIR=/data/uploads (см. README — раздел
# "Постоянное хранилище на Railway").
# DATA_DIR=/data
# UPLOADS_DIR=/data/uploads
