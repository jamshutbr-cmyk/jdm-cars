# Токен бота — ТОЛЬКО здесь, на сервере. Никогда не передавайте его во фронтенд.
# Получить/перевыпустить: @BotFather -> /mybots -> Bot Settings -> Revoke current token
BOT_TOKEN=your_bot_token_here

# Порт, на котором слушает API
PORT=8787

# Разрешённый origin фронтенда для CORS (адрес, где открыт Mini App / dev-сервер Vite)
CLIENT_ORIGIN=http://localhost:5173

# Отключает строгую проверку подписи Telegram initData и разрешает заголовок
# X-Dev-User для локального тестирования вне Telegram. НЕ включайте в проде.
DEV_MODE=true
